{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "../../node_modules/@geajs/vite-plugin/gea-env.d.ts"
  ],
  "exclude": ["preview", "vite.config.ts"]
}
